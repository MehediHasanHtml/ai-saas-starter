APP_NAME="AI SaaS Starter"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# PostgreSQL 16+ with the pgvector extension
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ai_saas
DB_USERNAME=postgres
DB_PASSWORD=postgres

SESSION_DRIVER=array
CACHE_STORE=redis
QUEUE_CONNECTION=redis
FILESYSTEM_DISK=local

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log

# ------------------------------------------------------------------
# AI providers — leave keys empty to use only the built-in demo model
# ------------------------------------------------------------------
# fake | openai | anthropic | gemini | ollama
AI_DEFAULT_PROVIDER=fake
AI_DEFAULT_MODEL=

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODELS=gpt-4.1-mini,gpt-4.1

ANTHROPIC_API_KEY=
ANTHROPIC_MODELS=claude-haiku-5-5,claude-sonnet-5-5

GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash,gemini-3.5-flash

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODELS=llama3.2

# Embeddings (one platform-wide vector space). Changing these requires
# a fresh migration of document_chunks + `php artisan rag:reindex`.
# fake | openai | gemini | ollama
AI_EMBEDDING_PROVIDER=fake
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536

RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=6
RAG_MIN_SCORE=0.2

# ------------------------------------------------------------------
# Stripe (Laravel Cashier) — optional; billing UI degrades gracefully
# ------------------------------------------------------------------
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
CASHIER_CURRENCY=usd
