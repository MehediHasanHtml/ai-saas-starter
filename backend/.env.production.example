# =====================================================================
#  Production settings for the Laravel API on cPanel.
#  On the server: copy this file to ".env" (same folder as "artisan")
#  and replace every value marked CHANGE ME. Never commit the real .env.
# =====================================================================

APP_NAME="Margin"
APP_ENV=production
APP_DEBUG=false
# Generated on the server with: php artisan key:generate --force
APP_KEY=
# CHANGE ME: the API's own address (cPanel subdomain), no trailing slash
APP_URL=https://api.yourdomain.com
# CHANGE ME: the Vercel site (used in invitation and Stripe links)
FRONTEND_URL=https://yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# ---------------------------------------------------------------------
# PostgreSQL with pgvector (cPanel > PostgreSQL Databases)
# cPanel prefixes names with your account name, e.g. myacct_margin
# ---------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=CHANGE_ME_dbname
DB_USERNAME=CHANGE_ME_dbuser
DB_PASSWORD=CHANGE_ME_strong_password

# ---------------------------------------------------------------------
# No Redis on shared hosting: cache, rate limits and the job queue are
# kept in the database (tables already exist). Logins use API tokens,
# so sessions are not stored.
# ---------------------------------------------------------------------
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=array
FILESYSTEM_DISK=local

# ---------------------------------------------------------------------
# Email (team invitations). cPanel > Email Accounts gives these values.
# ---------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mail.yourdomain.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=no-reply@yourdomain.com
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM_ADDRESS=no-reply@yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------
# AI. Use a NEW Gemini key (aistudio.google.com/apikey); delete the old
# one, it was exposed during development.
# ---------------------------------------------------------------------
AI_DEFAULT_PROVIDER=gemini
AI_DEFAULT_MODEL=gemini-3.5-flash-lite

GEMINI_API_KEY=CHANGE_ME
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash,gemini-3.5-flash

# Optional extra providers (leave empty to hide them as "no API key")
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODELS=gpt-4.1-mini,gpt-4.1
ANTHROPIC_API_KEY=
ANTHROPIC_MODELS=claude-haiku-5-5,claude-sonnet-5-5
# Ollama needs its own server; leave empty on cPanel so it isn't offered.
OLLAMA_BASE_URL=
OLLAMA_MODELS=

# Real semantic search for documents. Decide BEFORE uploading documents:
# changing these later requires re-indexing everything.
AI_EMBEDDING_PROVIDER=gemini
AI_EMBEDDING_MODEL=gemini-embedding-001
AI_EMBEDDING_DIMENSIONS=1536

RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=6
RAG_MIN_SCORE=0.2

# ---------------------------------------------------------------------
# Stripe (optional). Webhook URL: https://api.yourdomain.com/stripe/webhook
# ---------------------------------------------------------------------
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
CASHIER_CURRENCY=usd

# Which AI providers the Free plan may use (Pro and Business get all).
# Remove gemini to make it paid-only.
PLAN_FREE_PROVIDERS=fake,gemini,openai,ollama

# Leave false on a live site: demo users have the password "password".
SEED_DEMO_DATA=false
