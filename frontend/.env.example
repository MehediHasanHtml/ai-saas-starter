# Where the Next.js server reaches the Laravel API (server-side only).
# Local Docker: http://localhost:8000   Production (Vercel): https://api.yourdomain.com
API_URL=http://localhost:8000

# Product name shown in the UI.
NEXT_PUBLIC_APP_NAME=Margin

# Shows the seeded demo sign-in details on the login page.
# Local development only: leave unset (or false) on Vercel.
NEXT_PUBLIC_SHOW_DEMO_LOGIN=false
